{
  "name": "@swarnbook/business-logic",
  "version": "0.1.0",
  "private": true,
  "description": "Pure business logic functions for SwarnaLekh (GST, billing, interest, scheme calculations)",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "jest": "^30.0.0",
    "ts-jest": "^29.2.5",
    "@types/jest": "^30.0.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "testEnvironment": "node"
  }
}
