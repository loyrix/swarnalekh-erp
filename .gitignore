# ===========================
# SwarnBook Monorepo .gitignore
# ===========================

# --- Node.js ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/

# --- NestJS / TypeScript ---
dist/
build/
*.js.map
*.d.ts
!src/**/*.d.ts

# --- Prisma ---
apps/api/prisma/migrations/**/migration_lock.toml

# --- Environment ---
.env
.env.local
.env.*.local
!.env.example

# --- Turborepo ---
.turbo/

# --- Flutter / Dart ---
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
build/
*.dart_tool
*.iml

# Generated files
*.g.dart
*.freezed.dart
*.gr.dart
*.mocks.dart

# --- Supabase ---
supabase/.temp/
supabase/.branches/

# --- IDE ---
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# --- Testing ---
coverage/
.nyc_output/

# --- Logs ---
logs/
*.log

# --- OS ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db

# --- Misc ---
*.tgz
*.tar.gz
*.zip
