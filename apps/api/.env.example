# ===========================
# SwarnaLekh API — Environment Variables
# ===========================

# Temporary mobile auth provider config.
# The API does not require these; scripts/sync_mobile_env.mjs copies them to apps/mobile/.env.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# PostgreSQL database (Supabase pooler, AWS RDS, or any managed Postgres)
DATABASE_URL="postgresql://postgres.project-ref:password@region.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.project-ref:password@region.pooler.supabase.com:5432/postgres"

# API bearer JWT verification.
# Use the same HS256 secret as the provider currently issuing mobile access tokens.
AUTH_JWT_SECRET=replace-with-your-auth-provider-jwt-secret
# Backward-compatible alias if your local env already uses JWT_SECRET.
JWT_SECRET=


# Redis (Upstash) — optional until queues are enabled
UPSTASH_REDIS_URL=
UPSTASH_REDIS_TOKEN=

# Gemini inventory OCR
GEMINI_API_KEY=
GEMINI_INVENTORY_MODEL=gemini-2.5-flash-lite

# App
NODE_ENV=development
PORT=3000
API_VERSION=v1
